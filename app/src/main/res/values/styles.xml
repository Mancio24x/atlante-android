<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Launch theme; MainActivity switches to the chosen palette before drawing. -->
    <style name="AtlanteTheme" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:statusBarColor">#F2F0E7</item>
        <item name="android:navigationBarColor">#183D3B</item>
        <item name="android:windowActionModeOverlay">true</item>
        <item name="android:windowBackground">#000000</item>
    </style>

    <style name="Atlante.Base" parent="Theme.Material3.Light.NoActionBar">
        <item name="android:windowActionModeOverlay">true</item>
        <item name="chipStyle">@style/Widget.Material3.Chip.Filter</item>
        <item name="shapeAppearanceCornerMedium">@style/ShapeAppearance.Material3.Corner.Large</item>
    </style>
    <style name="Atlante.Base.Dark" parent="Theme.Material3.Dark.NoActionBar">
        <item name="android:windowActionModeOverlay">true</item>
        <item name="chipStyle">@style/Widget.Material3.Chip.Filter</item>
        <item name="shapeAppearanceCornerMedium">@style/ShapeAppearance.Material3.Corner.Large</item>
    </style>

    <!-- Overlays used to create Material buttons and fields in code with a specific style. -->
    <style name="Atlante.Button.Tonal" parent="">
        <item name="materialButtonStyle">@style/Widget.Material3.Button.TonalButton</item>
    </style>
    <style name="Atlante.Button.Text" parent="">
        <item name="materialButtonStyle">@style/Widget.Material3.Button.TextButton</item>
    </style>
    <style name="Atlante.Button.Icon" parent="">
        <item name="materialButtonStyle">@style/Widget.Material3.Button.IconButton</item>
    </style>
    <style name="Atlante.Button.Outlined" parent="">
        <item name="materialButtonStyle">@style/Widget.Material3.Button.OutlinedButton</item>
    </style>
    <style name="Atlante.Field" parent="">
        <item name="textInputStyle">@style/Widget.Material3.TextInputLayout.OutlinedBox</item>
    </style>
    <style name="Atlante.Field.Dropdown" parent="">
        <item name="textInputStyle">@style/Widget.Material3.TextInputLayout.OutlinedBox.ExposedDropdownMenu</item>
    </style>
</resources>
